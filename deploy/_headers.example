/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
/index.html
  Cache-Control: no-cache
/assets/index-*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/index-*.css
  Cache-Control: public, max-age=31536000, immutable
